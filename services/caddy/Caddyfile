# caddy is serving from the hostname multi-dwpc.cu-dbmi.dev
# serves Django's collected static files, and proxies everything else to the
# API at streamlit-api:8000
multi-dwpc.cu-dbmi.dev {
    handle_path /static/* {
        root * /opt/static
        file_server
    }

    handle {
        reverse_proxy streamlit-api:8000
    }
}
